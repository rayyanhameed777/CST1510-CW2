# =================================================================== FUNCTIONS

def parse_line(raw_line):
    """Clean one messy log line and return it as a dict."""
    line = raw_line.strip().lower()
    record = {}
    for piece in line.split(","):
        key, value = piece.split("=", 1)
        record[key.strip()] = value.strip()
    record["attempts"] = int(record["attempts"])
    return record


def status_of(record):
    """Return FLAGGED if 10+ failed attempts, otherwise OK."""
    if record["result"] == "failed" and record["attempts"] >= 10:
        return "FLAGGED"
    return "OK"


# ====================================================================== INPUT

raw_records = [
    "SRC=10.0.0.5,ATTEMPTS=12,RESULT=FAILED",
    "  src = 192.168.1.20 , Attempts=3 , result=Success  ",
    "SRC=172.16.0.9,attempts=45,RESULT=Failed",
    "  Src=10.0.0.77 ,ATTEMPTS = 1 , Result=SUCCESS",
    "src=203.0.113.4 , ATTEMPTS=10 , result=FAILED   ",
    "SRC=10.0.0.8,ATTEMPTS=7,RESULT=failed",
]


# =============================================================== PROCESS + OUTPUT

for raw_record in raw_records:
    record = parse_line(raw_record)
    print(record, status_of(record))